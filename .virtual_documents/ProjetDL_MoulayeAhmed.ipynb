import geopandas
# Charger les données géographiques des wilayas 
gdf = geopandas.read_file("archive(1)/Nigeria_states/Nigeria_Poly.shp")
gdf


# Fusionner les données PMI avec le GeoDataFrame
merged_gdf = gdf.merge(data, left_on='name', right_on='State', how='left')


merged_gdf.head()


# Vérifier et définir un CRS si nécessaire
if merged_gdf.crs is None:
    merged_gdf.set_crs(epsg=4326, inplace=True)  # CRS par défaut (WGS84)

# Projeter les données dans un système de coordonnées projeté pour des calculs précis
projected_gdf = merged_gdf.to_crs(epsg=3857)  # Projection EPSG:3857 (mètres)

# Calcul des limites de la carte
x_min, y_min, x_max, y_max = projected_gdf.total_bounds

# Configurer la carte
fig, ax = plt.subplots(1, 1, figsize=(8, 6))

# Tracer la carte avec une coloration basée sur les indices PMI
projected_gdf.plot(
    column='MPI Value',  # Colonne contenant les valeurs à représenter
    cmap='OrRd',         # Palette de couleurs
    legend=True,         # Afficher une légende
    legend_kwds={'label': "MPI Value Index"},  # Titre de la légende
    ax=ax
)

# Ajouter les noms des entités sur les centroïdes
centroids = projected_gdf.geometry.centroid
for x, y, label in zip(centroids.x, centroids.y, projected_gdf['name']):
    ax.text(x, y, label, fontsize=8, ha='center')

# Définir les limites de la carte
ax.set_xlim([x_min, x_max])
ax.set_ylim([y_min, y_max])

# Ajouter un titre
ax.set_title("Carte des indices PMI par État au Nigeria", fontsize=16)

# Afficher la carte
plt.show()


